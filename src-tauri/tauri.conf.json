{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Appointment",
  "version": "1.2.0",
  "identifier": "com.connacri.appointment",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Appointment — Hotel Management",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "Hotel and property management system",
    "longDescription": "Appointment hotel management with native Windows file access and secure credential storage.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English",
          "French",
          "Arabic"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "../assets/icon.png"
    ]
  }
}
